# =============================================================================
# Thermal Capital — Environment Variables
# =============================================================================
# Copy this file to `.env` for local development or configure in Vercel Project Settings.
# NOTE: Secrets are strictly server-side and never exposed to the frontend bundle.

# Offline Demo Mock API Mode (Set to true to run fully offline using fixtures/fortyguard/)
# When enabled, FortyGuardClient serves schema-identical authentic responses offline
# with geographic nearest-neighbor matching and requires no valid API key.
USE_MOCK_API=true

# FortyGuard API Authentication (Required ONLY if USE_MOCK_API=false)
FORTYGUARD_API_KEY=your_api_key_here

# CARTO Basemaps API Key (Public / Client-Side — for unwatermarked raster basemap tiles)
VITE_CARTO_API_KEY=your_carto_api_key_here

# FortyGuard API Base URL (Optional — defaults to production API)
# Production:  https://api.fortyguard.com
# Development: https://tos-enterprise-api.dev.app.fortyguard.com
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# CORS Configuration (Optional — comma-separated allowed origins for custom production domains)
# Example: https://thermal-capital.nyc.gov,https://your-custom-domain.com
# By default, Vercel deployments automatically allow same-origin and *.vercel.app domains.
ALLOWED_ORIGINS=
