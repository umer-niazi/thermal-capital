# =============================================================================
# Thermal Capital — Vercel Function Bundle Exclusion (.vercelignore)
# =============================================================================
# Exclude build artifacts, dev dependencies, notebooks, and test caches.
# NOTE: Do NOT ignore frontend/ here because Vercel requires frontend/package.json
# to execute `npm --prefix frontend install` and `npm --prefix frontend run build`.

# Local development virtual environments & cache
.venv/
venv/
env/
.pytest_cache/
data/cache/
*.pyc
__pycache__/

# Version control & CI
.git/
.github/

# Jupyter Notebooks & exploratory scripts
notebooks/
scripts/
docs/
assets/
outputs/
.scratch/

# Backend test suite & dev requirements
backend/tests/
requirements-dev.txt
